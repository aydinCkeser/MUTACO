{
  "schema_version": "mutaco-benchmark-campaign-v1",
  "campaign_classification": "mechanical_smoke",
  "dtype": "float32",
  "device": "auto",
  "campaign": {
    "target_count": 1,
    "target_bank_policy": "scrambled_sobol",
    "campaign_seed": 60101,
    "replay_policy": "first_middle_last"
  },
  "simulator": {
    "adapter": "handwritten_analytic",
    "identifier": "handwritten",
    "noise_mode": "task_diagonal_gaussian",
    "noise_std": [0.04, 0.06, 0.05]
  },
  "comparison_set": {
    "policy": "full_bank"
  },
  "reference_method": "mutaco",
  "sbi_methods": [
    "sbi_npe",
    "sbi_nle",
    "sbi_snle",
    "sbi_nre",
    "sbi_snre"
  ],
  "views": ["cold_start_per_target"],
  "regimes": ["equal_simulator_calls"],
  "process_policy": "fresh_method_process",
  "simulation_budget_per_target": 14,
  "runner": {
    "initial_points": 8,
    "sequential_rounds": 6,
    "transform": {
      "ddof": 1,
      "scale_floor": 1e-12
    },
    "gp": {
      "likelihood": "task_diagonal_gaussian",
      "max_iterations": 2
    },
    "acquisition": {
      "raw_policy": "scrambled_sobol",
      "raw_samples": 8,
      "restarts": 1,
      "max_iterations": 1,
      "learning_rate": 0.05,
      "alpha": 0.1,
      "tau_interior": 1e-8
    },
    "recommendation_policy": "final_posterior_standardized_l1"
  },
  "sbi": {
    "density_estimator": "maf",
    "classifier": "mlp",
    "training_batch_size": 10,
    "validation_fraction": 0.2,
    "snre_validation_fraction": 0.4,
    "stop_after_epochs": 2,
    "max_num_epochs": 2,
    "posterior_samples": 64,
    "show_progress_bars": false,
    "mcmc": {
      "method": "slice_np_vectorized",
      "num_chains": 2,
      "warmup_steps": 2,
      "thin": 1,
      "init_strategy": "proposal"
    }
  }
}
