figure.figsize: 10.5, 4.0
figure.dpi: 120
savefig.dpi: 300
font.family: sans-serif
font.size: 10
axes.labelsize: 10
axes.titlesize: 11
xtick.labelsize: 9
ytick.labelsize: 9
